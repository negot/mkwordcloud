{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "chrome"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "infra/bin/**/*.ts",
    "infra/lib/**/*.ts",
    "infra/test/**/*.ts",
    "scripts/deploy/src/**/*.ts",
    "scripts/deploy/test/**/*.ts",
    "vitest.config.ts"
  ]
}
